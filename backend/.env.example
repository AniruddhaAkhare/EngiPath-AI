# ==============================================================================
# EngiPath AI — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ==============================================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-secret-key

# --- Database ---
# Development (SQLite):
DATABASE_URL=sqlite:///engipath.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/engipath

# ==============================================================================
# GEMINI API KEYS — STRICTLY SEPARATED
# These two keys MUST remain isolated. Never use one where the other is required.
# ==============================================================================

# Classes module ONLY — used by ClassesGeminiService
CLASSES_GEMINI_API_KEY=your-classes-gemini-api-key-here
CLASSES_GEMINI_MODEL=gemini-2.0-flash

# Internship + Resume module ONLY — used by InternshipGeminiService
INTERNSHIP_GEMINI_API_KEY=your-internship-gemini-api-key-here
INTERNSHIP_GEMINI_MODEL=gemini-2.0-flash

# ==============================================================================
# WEB SEARCH
# Primary: Google Programmable Search Engine (free tier: 100 queries/day)
# Fallback: DuckDuckGo (no key required)
# ==============================================================================
SEARCH_API_KEY=your-google-custom-search-api-key-here
SEARCH_ENGINE_ID=your-google-programmable-search-engine-id-here

# ==============================================================================
# MAPS / GEOCODING (all free, no API key required)
# ==============================================================================
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=EngiPathAI/1.0
OSRM_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ==============================================================================
# FILE UPLOADS
# ==============================================================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760
# Delete resumes after analysis (recommended for privacy)
DELETE_RESUME_AFTER_ANALYSIS=true

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=INFO

# ==============================================================================
# RATE LIMITING (per-service, in seconds)
# ==============================================================================
NOMINATIM_RATE_LIMIT_SECONDS=1
SCRAPER_REQUEST_TIMEOUT=15
SCRAPER_MAX_RETRIES=3
